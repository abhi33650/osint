# ─────────────────────────────────────────────────────────────
# LinkTrack environment configuration
# Copy the values you need into `.env` (which is gitignored).
# ─────────────────────────────────────────────────────────────

# --- Legacy Express phone API (existing) ---
PORT=4000
NumberAPI=your_number_api_key

# --- Database (REQUIRED) ---
# Local:   mongodb://127.0.0.1:27017/linktrack
# Atlas:   mongodb+srv://user:pass@cluster.mongodb.net/linktrack
MONGODB_URI=mongodb://127.0.0.1:27017/linktrack

# --- Auth (REQUIRED) ---
# Generate a strong secret, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
# Session lifetime
JWT_EXPIRES_IN=7d

# --- Initial admin (used by `npm run seed`) ---
SEED_ADMIN_EMAIL=admin@linktrack.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=LinkTrack Admin

# --- App ---
# Public base URL used when generating shareable tracking links.


# --- Email Intelligence (OPTIONAL third-party APIs) ---
# Have I Been Pwned (breach lookups). Without a key, breach checks return "Not verified".
# Get one: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=
# Gravatar is keyless (public). No config needed.
